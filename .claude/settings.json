{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)"
    ]
  }
}
