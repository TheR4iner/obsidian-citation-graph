{
  "name": "obsidian-citation-graph",
  "version": "0.4.0",
  "description": "Create Litmaps-style citation graph canvases from Zotero collections",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "vitest run",
    "lint": "eslint .",
    "test:watch": "vitest",
    "build": "tsc -noEmit -skipLibCheck && vitest run && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "zotero",
    "citation",
    "graph",
    "canvas"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
